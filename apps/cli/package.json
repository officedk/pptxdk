{
  "name": "@pptxdk/cli",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pptxdk/pptxdk.git",
    "directory": "apps/cli"
  },
  "bin": {
    "pptxdk": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*.ts": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#/*.tsx": {
      "source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false && chmod +x dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ykdz/cli-contract": "catalog:",
    "fflate": "catalog:",
    "pptxdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pptxdk/tooling-config": "workspace:*",
    "@pptxdk/validation": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
