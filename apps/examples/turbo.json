{
  "extends": ["//"],
  "tags": ["layer:application"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "vitest.config.ts",
        "tsconfig.node.json"
      ],
      "outputs": ["test-results/**"],
      "cache": false,
      "tags": ["quality:heavy"]
    }
  }
}
