{
  "name": "@react-pptx/capabilities",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*.ts": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#/*.tsx": {
      "source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shape": {
      "source": "./src/shape.ts",
      "types": "./dist/shape.d.ts",
      "default": "./dist/shape.js"
    },
    "./shape-elements": {
      "source": "./src/shape-elements.ts",
      "types": "./dist/shape-elements.d.ts",
      "default": "./dist/shape-elements.js"
    },
    "./box": {
      "source": "./src/box.ts",
      "types": "./dist/box.d.ts",
      "default": "./dist/box.js"
    },
    "./box-elements": {
      "source": "./src/box-elements.ts",
      "types": "./dist/box-elements.d.ts",
      "default": "./dist/box-elements.js"
    },
    "./document": {
      "source": "./src/document.ts",
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./font": {
      "source": "./src/font.ts",
      "types": "./dist/font.d.ts",
      "default": "./dist/font.js"
    },
    "./chart": {
      "source": "./src/chart.ts",
      "types": "./dist/chart.d.ts",
      "default": "./dist/chart.js"
    },
    "./text": {
      "source": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./text-elements": {
      "source": "./src/text-elements.ts",
      "types": "./dist/text-elements.d.ts",
      "default": "./dist/text-elements.js"
    },
    "./table": {
      "source": "./src/table.ts",
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./transition": {
      "source": "./src/transition.ts",
      "types": "./dist/transition.d.ts",
      "default": "./dist/transition.js"
    },
    "./motion": {
      "source": "./src/motion.ts",
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    },
    "./motion-elements": {
      "source": "./src/motion-elements.ts",
      "types": "./dist/motion-elements.d.ts",
      "default": "./dist/motion-elements.js"
    },
    "./image": {
      "source": "./src/image.ts",
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./image-elements": {
      "source": "./src/image-elements.ts",
      "types": "./dist/image-elements.d.ts",
      "default": "./dist/image-elements.js"
    },
    "./group": {
      "source": "./src/group.ts",
      "types": "./dist/group.d.ts",
      "default": "./dist/group.js"
    },
    "./group-elements": {
      "source": "./src/group-elements.ts",
      "types": "./dist/group-elements.d.ts",
      "default": "./dist/group-elements.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false"
  },
  "dependencies": {
    "@react-pptx/core": "workspace:*",
    "fflate": "catalog:",
    "fontkit": "catalog:",
    "harfbuzzjs": "catalog:",
    "linebreak": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@react-pptx/tooling-config": "workspace:*",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
