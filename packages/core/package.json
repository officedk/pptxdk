{
  "name": "@react-pptx/core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*.ts": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#/*.tsx": {
      "source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false"
  },
  "dependencies": {
    "fflate": "catalog:",
    "react": "catalog:",
    "react-reconciler": "catalog:",
    "yoga-layout": "catalog:"
  },
  "devDependencies": {
    "@react-pptx/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-reconciler": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
