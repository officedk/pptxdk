{
  "name": "@pptxdk/import",
  "version": "0.0.0",
  "private": true,
  "description": "Transitional PPTX import stage producing unified editable documents and structured diagnostics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pptxdk/pptxdk.git",
    "directory": "packages/import"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*.ts": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@pptxdk/core": "workspace:*",
    "@xmldom/xmldom": "catalog:",
    "fflate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pptxdk/tooling-config": "workspace:*",
    "@pptxdk/validation": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
