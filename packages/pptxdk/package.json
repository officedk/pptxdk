{
  "name": "@officedk/pptxdk",
  "version": "0.2.0",
  "description": "From TypeScript to PowerPoint and back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officedk/pptxdk.git",
    "directory": "packages/pptxdk"
  },
  "bin": {
    "pptxdk": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./react": {
      "source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vanilla": {
      "source": "./src/vanilla.ts",
      "types": "./dist/vanilla.d.ts",
      "default": "./dist/vanilla.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./preview": {
      "source": "./src/preview.ts",
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./build": "./dist/build.js",
      "./react": "./dist/react.js",
      "./vanilla": "./dist/vanilla.js",
      "./node": "./dist/node.js",
      "./preview": "./dist/preview.js"
    },
    "access": "public"
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false && rolldown -c && rm -rf dist/.declarations && chmod +x dist/cli.js",
    "test": "vitest run",
    "check:conditional": "node --conditions=source scripts/check-external-corpus.ts"
  },
  "dependencies": {
    "@boringparts/cli-contract": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@xmldom/xmldom": "catalog:",
    "esbuild": "catalog:",
    "fflate": "catalog:",
    "fontkit": "catalog:",
    "harfbuzzjs": "catalog:",
    "jpeg-js": "catalog:",
    "linebreak": "catalog:",
    "pngjs": "catalog:",
    "react": "catalog:",
    "react-reconciler": "catalog:",
    "yoga-layout": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pptxdk/capabilities": "workspace:*",
    "@pptxdk/codegen": "workspace:*",
    "@pptxdk/core": "workspace:*",
    "@pptxdk/emit": "workspace:*",
    "@pptxdk/import": "workspace:*",
    "@pptxdk/preview": "workspace:*",
    "@pptxdk/react": "workspace:*",
    "@pptxdk/tooling-config": "workspace:*",
    "@pptxdk/validation": "workspace:*",
    "@types/emscripten": "catalog:",
    "@types/pngjs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
