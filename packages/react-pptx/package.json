{
  "name": "@react-pptx/react-pptx",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*.ts": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#/*.tsx": {
      "source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./document": {
      "source": "./src/document.ts",
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./preview": {
      "source": "./src/preview.ts",
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./shape": {
      "source": "./src/shape.ts",
      "types": "./dist/shape.d.ts",
      "default": "./dist/shape.js"
    },
    "./chart": {
      "source": "./src/chart.ts",
      "types": "./dist/chart.d.ts",
      "default": "./dist/chart.js"
    },
    "./text": {
      "source": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-pptx/capabilities": "workspace:*",
    "@react-pptx/core": "workspace:*",
    "@react-pptx/emit": "workspace:*",
    "@react-pptx/preview": "workspace:*",
    "esbuild": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@react-pptx/tooling-config": "workspace:*",
    "@react-pptx/validation": "workspace:*",
    "@types/emscripten": "catalog:",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "fflate": "catalog:",
    "fontkit": "catalog:",
    "harfbuzzjs": "catalog:",
    "jpeg-js": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pngjs": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
