{
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#verify:artifact-consumption": {
      "dependsOn": [
        "@react-pptx/cli#build",
        "@react-pptx/react-pptx#build",
        "@react-pptx/validation#build",
        "@react-pptx/showcase#build"
      ],
      "inputs": [
        "scripts/verify-artifact-consumption.ts",
        "scripts/assets/fonts/**",
        "package.json",
        "apps/cli/package.json",
        "apps/cli/src/**",
        "apps/cli/dist/**",
        "pnpm-workspace.yaml",
        "packages/core/package.json",
        "packages/capabilities/package.json",
        "packages/react-pptx/package.json",
        "packages/validation/package.json",
        "packages/core/dist/**",
        "packages/capabilities/dist/**",
        "packages/react-pptx/dist/**",
        "packages/validation/dist/**",
        "pnpm-lock.yaml",
        "examples/showcase/package.json",
        "examples/showcase/src/**",
        "examples/showcase/dist/**"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#publication:pack": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#publication:publish": {
      "tags": ["work:release"],
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "layer:tooling": {
        "dependencies": {
          "allow": []
        }
      },
      "layer:validation": {
        "dependencies": {
          "allow": ["layer:tooling"]
        }
      },
      "layer:core": {
        "dependencies": {
          "allow": ["layer:tooling", "layer:validation"]
        }
      },
      "layer:capabilities": {
        "dependencies": {
          "allow": ["layer:tooling", "layer:validation", "layer:core"]
        }
      },
      "layer:entry": {
        "dependencies": {
          "allow": [
            "layer:tooling",
            "layer:validation",
            "layer:core",
            "layer:capabilities"
          ]
        }
      },
      "layer:example": {
        "dependencies": {
          "allow": [
            "layer:tooling",
            "layer:validation",
            "layer:core",
            "layer:capabilities",
            "layer:entry",
            "layer:application"
          ]
        }
      },
      "layer:application": {
        "dependencies": {
          "allow": [
            "layer:tooling",
            "layer:validation",
            "layer:core",
            "layer:capabilities",
            "layer:entry"
          ]
        }
      }
    }
  },
  "globalDependencies": [
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts"
  ]
}
